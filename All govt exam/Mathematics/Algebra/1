-- Linear Equations --

16. 3x + 6 = 0 => x=-2
17. 5x - 15 = 0 => x=3
18. x + y = 5 ; 2x - y = 1 => x=2, y=3
19. 2x + 3y = 13 ; 3x - 3y = 3 => x=16/5, y=11/5
20. x - y = 4 ; x + y = 10 => x=7, y=3
21. 4x + 2y = 14 ; 3x - y = 5 => x=3, y=1
22. 2x + 5 = 0 => x=-5/2
23. 6x - 3y = 9 ; x + y = 5 => x=3, y=2
24. 5x - 2y = 4 ; 3x + y = 5 => x=2, y=1
